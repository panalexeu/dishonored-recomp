diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index a7443756..4e006af4 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -70,10 +70,24 @@ REXCVAR_DEFINE_BOOL(readback_memexport_fast, true, "GPU",
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
 REXCVAR_DEFINE_INT32(query_occlusion_fake_sample_count, 1000, "GPU",
-                     "Fake sample count for occlusion queries")
+                     "Unused: replaced by query_occlusion_sample_lower/upper_threshold")
     .range(1, 100000)
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
+// Canary b447699a5 ("Occlusion query faking extension"), needed by Dishonored (425307E3):
+// a constant fake count makes the game hide most meshes.
+REXCVAR_DEFINE_INT32(query_occlusion_sample_lower_threshold, 80, "GPU",
+                     "Fake occlusion query results count down from the upper threshold to "
+                     "this one and start over. -1: write no sample counts (games may hang); "
+                     "0 with upper 0: everything reported as occluded")
+    .range(-1, 100000)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_INT32(query_occlusion_sample_upper_threshold, 100, "GPU",
+                     "Upper end of the fake occlusion sample count cycle (>= lower threshold)")
+    .range(0, 100000)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 REXCVAR_DEFINE_BOOL(async_shader_compilation, true, "GPU",
                     "Compile shaders and create pipelines asynchronously in background "
                     "threads. This reduces stutter but may cause brief visual artifacts while "
@@ -1257,8 +1271,8 @@ bool CommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(memory::RingBuffer* re
 
   // Occlusion queries:
   // This command is send on query begin and end.
-  // As a workaround report some fixed amount of passed samples.
-  auto fake_sample_count = REXCVAR_GET(query_occlusion_fake_sample_count);
+  // As a workaround report a varying amount of passed samples.
+  int64_t fake_sample_count = NextFakeOcclusionSampleCount();
   if (fake_sample_count >= 0) {
     auto* pSampleCounts = memory_->TranslatePhysical<xe_gpu_depth_sample_counts*>(
         register_file_->values[XE_GPU_REG_RB_SAMPLE_COUNT_ADDR]);
@@ -1274,14 +1288,26 @@ bool CommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(memory::RingBuffer* re
         pSampleCounts->ZFail_A == kQueryFinished || pSampleCounts->ZFail_B == kQueryFinished;
     std::memset(pSampleCounts, 0, sizeof(xe_gpu_depth_sample_counts));
     if (is_end_via_z_pass || is_end_via_z_fail) {
-      pSampleCounts->ZPass_A = fake_sample_count;
-      pSampleCounts->Total_A = fake_sample_count;
+      pSampleCounts->ZPass_A = uint32_t(fake_sample_count);
+      pSampleCounts->Total_A = uint32_t(fake_sample_count);
     }
   }
 
   return true;
 }
 
+int64_t CommandProcessor::NextFakeOcclusionSampleCount() {
+  int32_t lower = REXCVAR_GET(query_occlusion_sample_lower_threshold);
+  if (lower < 0) {
+    return -1;
+  }
+  int32_t upper = std::max(REXCVAR_GET(query_occlusion_sample_upper_threshold), lower);
+  // Only the command processor thread issues ZPD events.
+  static int32_t samples = -1;
+  samples = (samples <= lower || samples > upper) ? upper : samples - 1;
+  return samples;
+}
